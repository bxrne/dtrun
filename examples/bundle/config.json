{
	"ociVersion": "1.0.0",
	"root": {
		"path": "rootfs",
		"readonly": false
	},
	"hostname": "dtrun-demo",
	"process": {
		"args": [
			"/bin/sh",
			"-c",
			"echo hostname=$(hostname); echo cwd=$(pwd); echo uid=$(id -u); echo gid=$(id -g); echo env=$DT_DEMO_VAR"
		],
		"env": [
			"PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
			"TERM=xterm",
			"DT_DEMO_VAR=hello-from-oci"
		],
		"cwd": "/"
	}
}
